{
  "name": "bloom-english",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_DB_TESTS=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:apply": "node --env-file-if-exists=.env scripts/apply-migrations.mjs",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/internals": "6.19.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
